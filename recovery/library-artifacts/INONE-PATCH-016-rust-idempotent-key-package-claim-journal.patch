+    /// Повторяет освобождение claims, для которых сервер однозначно отклонил Commit.
+    fn flush_pending_key_package_releases(&self) -> Result<usize, String> {
+        let mut stmt = self.meta.prepare(
+            "SELECT client_operation_id, claim_id FROM client_key_package_intents WHERE state = 'release_pending' AND claim_id IS NOT NULL ORDER BY created_at",
+        ).map_err(text)?;
+        let rows = stmt.query_map([], |row| Ok((row.get::<_, String>(0)?, row.get::<_, String>(1)?))).map_err(text)?;
+        let pending = rows.collect::<Result<Vec<_>, _>>().map_err(text)?;
+        drop(stmt);
+        let mut released = 0;
+        for (operation_id, claim_id) in pending {
+            let path = format!("/mls/key-packages/claims/{}/release", urlencoding::encode(&claim_id));
+            match self.call("POST", &path, Some(json!({}))) {
+                Ok(_) => {}
+                Err(error) if http_status_code(&error) == Some(404) => {} // истёкший/уже освобождённый claim
+                Err(error) => return Err(format!("claim {claim_id} ожидает освобождения: {error}")),
+            }
+            self.meta.execute(
+                "DELETE FROM client_key_package_intents WHERE client_operation_id = ?1",
+                [&operation_id],
+            ).map_err(text)?;
+            released += 1;
+        }
+        Ok(released)
+    }
