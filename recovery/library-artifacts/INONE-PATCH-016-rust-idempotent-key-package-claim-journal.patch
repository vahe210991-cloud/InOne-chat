+    /// Возобновляет pre-claim intents, у которых ещё нет отправленного membership Commit.
+    /// Вызывается после синхронизации комнат, чтобы не строить Commit на устаревшей эпохе.
+    fn resume_pending_key_package_invites(&mut self) -> Result<usize, String> {
+        let pending: Vec<(String, String)> = {
+            let mut stmt = self.meta.prepare(
+                "SELECT i.room_id, i.target_user_id FROM client_key_package_intents i
+                 WHERE i.state != 'release_pending'
+                   AND NOT EXISTS (SELECT 1 FROM client_membership_commits c WHERE c.client_operation_id = i.client_operation_id)
+                 ORDER BY i.created_at, i.client_operation_id",
+            ).map_err(text)?;
+            let rows = stmt.query_map([], |row| Ok((row.get(0)?, row.get(1)?))).map_err(text)?;
+            rows.collect::<Result<Vec<_>, _>>().map_err(text)?
+        };
+        let mut resumed = 0;
+        for (room_id, target_user_id) in pending {
+            // WaitingForCommit, RecoveryRequired and maintenance are not writable states.
+            // Keep the durable intent; a later sync can resume it after room recovery.
+            match self.ensure_writable(&room_id) {
+                Ok(()) => {}
+                Err(error)
+                    if error.starts_with("WaitingForCommit:")
+                        || error.starts_with("комната требует восстановления")
+                        || error == remote_config::MAINTENANCE_MESSAGE => continue,
+                Err(error) => return Err(error),
+            }
+            self.invite(&room_id, &target_user_id)?;
+            resumed += 1;
+        }
+        Ok(resumed)
+    }
