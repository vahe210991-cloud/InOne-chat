+#[test]
+fn key_package_claim_replays_same_operation_after_response_loss_and_process_restart() {
+    let mut engine = Engine::start();
+    let keys = MemoryKeyStore::default();
+    let alice_db = db("claim-alice");
+    let mut alice = connect(&engine.base, ALICE, PW, "A_PHONE", &alice_db, &keys).unwrap();
+    let mut bob = connect(&engine.base, BOB, PW, "B_PHONE", &db("claim-bob"), &keys).unwrap();
+    bob.ensure_key_packages(1).unwrap();
+    alice.create_room(ROOM).unwrap();
+
+    // The server reserves the packages and then loses the HTTP response. The local
+    // intent must already be durable, so retry after restart reuses the same op ID.
+    engine.command("FAIL_KEY_PACKAGE_CLAIM_RESPONSE");
+    let first = alice.invite(ROOM, BOB).expect_err("claim response must be lost");
+    assert!(first.contains("500"), "expected injected claim response loss: {first}");
+    assert_eq!(alice.pending_key_package_intents().unwrap(), 1);
+    assert_eq!(alice.pending_membership_commits().unwrap(), 0, "MLS staging starts only after claim bytes are durably stored");
+    assert_eq!(alice.local_epoch(ROOM), Some(0));
+
+    drop(alice);
+    let mut alice = connect(&engine.base, ALICE, PW, "A_PHONE", &alice_db, &keys).unwrap();
+    assert_eq!(alice.pending_key_package_intents().unwrap(), 1, "pre-claim intent survives process restart");
+    alice.sync().expect("sync must resume the same claim operation and replay byte-identical KeyPackages");
+    assert_eq!(alice.pending_key_package_intents().unwrap(), 0, "server ACK atomically completes the intent");
+    assert_eq!(alice.pending_membership_commits().unwrap(), 0);
+    assert_eq!(alice.local_epoch(ROOM), Some(1));
+    bob.sync().unwrap();
+    assert!(bob.members_of(ROOM).unwrap().iter().any(|member| member == "@bob:inone.test/B_PHONE"));
+}
