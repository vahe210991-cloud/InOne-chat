+    fn existing_device_ids_in_room(&self, room_id: &str, target_user_id: &str) -> Result<Vec<String>, String> {
+        let group = self.groups.get(room_id).ok_or("комната не создана на этом устройстве")?;
+        let prefix = format!("{target_user_id}/");
+        let mut devices = BTreeSet::new();
+        for member in group.mls.members() {
+            let identity = mls_credential_identity(member.credential.serialized_content())?;
