+#[test]
+fn inviting_existing_room_member_claims_only_the_new_device() {
+    use mls_client::connect_with_approval;
+
+    let mut engine = Engine::start();
+    let keys = MemoryKeyStore::default();
+    let mut alice = connect(&engine.base, ALICE, PW, "A_PHONE", &db("existing-alice"), &keys).unwrap();
+    let mut bob_phone = connect(&engine.base, BOB, PW, "B_PHONE", &db("existing-bob-phone"), &keys).unwrap();
+    bob_phone.ensure_key_packages(1).unwrap();
+    alice.create_room(ROOM).unwrap();
+    alice.invite(ROOM, BOB).unwrap();
+    bob_phone.sync().unwrap();
+
+    let mut bob_new = connect_with_approval(
+        &engine.base, BOB, PW, "B_NEW", &db("existing-bob-new"), &keys, &bob_phone,
+    ).unwrap();
+    bob_new.ensure_key_packages(1).unwrap();
+    alice.invite(ROOM, BOB).expect("existing member's new device should receive a Welcome");
+    bob_new.sync().unwrap();
+    let members = bob_new.members_of(ROOM).unwrap();
+    assert!(members.iter().any(|member| member == "@bob:inone.test/B_PHONE"));
+    assert!(members.iter().any(|member| member == "@bob:inone.test/B_NEW"));
