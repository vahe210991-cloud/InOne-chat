+    /// Восстанавливает ACK исходящего сообщения по точному ciphertext из серверной истории.
+    /// Это закрывает окно: сервер уже записал событие, но HTTP-ответ потерян до локальной фиксации event_id.
+    fn mark_outbound_event_seen(&mut self, room_id: &str, event_id: &str, ciphertext: &str) -> Result<bool, String> {
+        use rusqlite::OptionalExtension;
+        let client_message_id: Option<String> = self.meta.query_row(
+            "SELECT client_message_id FROM client_outbound_messages
+             WHERE room_id = ?1 AND ciphertext = ?2 AND event_id IS NULL",
+            (room_id, ciphertext),
+            |row| row.get(0),
+        ).optional().map_err(text)?;
+        let Some(client_message_id) = client_message_id else { return Ok(false) };
+
+        let tx = self.meta.unchecked_transaction().map_err(|e| format!("временная ошибка хранилища: {e}"))?;
+        let changed = tx.execute(
+            "UPDATE client_outbound_messages SET event_id = ?1, ciphertext = NULL
+             WHERE client_message_id = ?2 AND room_id = ?3 AND ciphertext = ?4 AND event_id IS NULL",
+            (event_id, &client_message_id, room_id, ciphertext),
+        ).map_err(text)?;
+        if changed != 1 {
+            return Err("не удалось связать серверное событие с ожидающим исходящим сообщением".to_string());
+        }
+        tx.execute("INSERT OR IGNORE INTO client_processed (event_id) VALUES (?1)", [event_id]).map_err(text)?;
+        tx.commit().map_err(|e| format!("временная ошибка фиксации восстановленного ACK: {e}"))?;
+        self.processed.insert(event_id.to_string());
+        Ok(true)
+    }
