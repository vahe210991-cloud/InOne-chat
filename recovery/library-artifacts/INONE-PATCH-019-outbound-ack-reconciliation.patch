+#[test]
+fn accepted_message_with_lost_response_is_reconciled_from_history_before_retry() {
+    let mut engine = Engine::start();
+    let keys = MemoryKeyStore::default();
+    let mut alice = connect(&engine.base, ALICE, PW, "A_PHONE", &db("message-ack-alice"), &keys).unwrap();
+    let mut bob = connect(&engine.base, BOB, PW, "B_PHONE", &db("message-ack-bob"), &keys).unwrap();
+    bob.ensure_key_packages(1).unwrap();
+    alice.create_room(ROOM).unwrap();
+    alice.invite(ROOM, BOB).unwrap();
+    bob.sync().unwrap();
+
+    alice.enqueue_text(ROOM, "accepted once").unwrap();
+    engine.command("FAIL_MESSAGE_RESPONSE");
+    assert_eq!(alice.flush_outbox().unwrap(), 0, "потерянный ответ оставляет outbox на месте");
+    assert_eq!(alice.outbox_len().unwrap(), 1);
+
+    // sync sees the event already committed by the server. It must reconcile it with
+    // the exact durable ciphertext, not try to decrypt/re-deliver Alice's own message.
+    assert!(alice.sync().unwrap().is_empty(), "собственное отправленное сообщение не попадает во входящий inbox");
+    assert_eq!(alice.pending_incoming().unwrap().len(), 0);
+    assert_eq!(alice.flush_outbox().unwrap(), 1, "повтор использует восстановленный event_id");
+    assert_eq!(alice.outbox_len().unwrap(), 0);
+
+    let received = bob.sync().unwrap();
+    let texts: Vec<String> = received.iter().filter_map(|item| match item {
+        Incoming::Text { text, .. } => Some(text.clone()),
+        _ => None,
+    }).collect();
+    assert_eq!(texts, vec!["accepted once"]);
+    assert!(bob.sync().unwrap().is_empty(), "повторная синхронизация не создаёт дубликат");
+}