--- a/migrations/0028-mls-message-idempotency-fingerprint.sql
+++ b/migrations/0028-mls-message-idempotency-fingerprint.sql
@@ -0,0 +1,5 @@
+-- Bind each client message ID to the exact encrypted application payload.
+-- Existing rows remain NULL for backward-compatible replay of already accepted messages.
+ALTER TABLE mls_client_messages
+  ADD COLUMN IF NOT EXISTS request_hash TEXT
+  CHECK (request_hash IS NULL OR length(request_hash) = 64);
--- a/test/mls-message-idempotency-store.test.js
+++ b/test/mls-message-idempotency-store.test.js
@@ -0,0 +1,33 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createMemoryStore } from '../src/store-memory.js';
+
+const ROOM = '!message-idempotency:test';
+const ALICE = '@alice:test';
+
+test('clientMessageId is bound to one exact encrypted payload', () => {
+  const store = createMemoryStore({ pinPepper: 'p'.repeat(32) });
+  store.createRoom(ROOM, ALICE, [ALICE]);
+  const committed = store.mlsApplyCommit(ROOM, 0, {
+    senderId: ALICE,
+    senderDeviceId: 'A_PHONE',
+    commit: Buffer.from('opaque-commit'),
+    welcomes: [],
+    changes: { adds: [], removes: [] },
+  }, 1);
+  assert.equal(committed.ok, true);
+  assert.equal(committed.epoch, 1);
+
+  const firstContent = { mls: 'ciphertext-one', kind: 'text', forwarded: false };
+  const first = store.appendClientMessage(ROOM, ALICE, 'stable-message-1', 'a'.repeat(64), firstContent, 2, 1);
+  const replay = store.appendClientMessage(ROOM, ALICE, 'stable-message-1', 'a'.repeat(64), firstContent, 3, 1);
+  const conflict = store.appendClientMessage(
+    ROOM, ALICE, 'stable-message-1', 'b'.repeat(64),
+    { ...firstContent, mls: 'ciphertext-two' }, 4, 1,
+  );
+
+  assert.deepEqual(first, { state: 'created', seq: 1 });
+  assert.deepEqual(replay, { state: 'done', seq: 1 });
+  assert.deepEqual(conflict, { state: 'conflict' });
+  assert.equal(store.roomEventRows(ROOM, 0).length, 1, 'payload conflict must not create another event');
+});