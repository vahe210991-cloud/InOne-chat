 #[test]
+fn retrying_invite_after_commit_ack_loss_is_an_idempotent_success() {
+    let mut engine = Engine::start();
+    let keys = MemoryKeyStore::default();
+    let mut alice = connect(&engine.base, ALICE, PW, "A_PHONE", &db("invite-retry-alice"), &keys).unwrap();
+    let mut bob = connect(&engine.base, BOB, PW, "B_PHONE", &db("invite-retry-bob"), &keys).unwrap();
+    bob.ensure_key_packages(1).unwrap();
+    alice.create_room(ROOM).unwrap();
+
+    // The server commits the invite but loses its ACK. A user retry first replays
+    // the exact pending Commit; the now-complete invitation must not surface as 409.
+    engine.command("FAIL_COMMIT_RESPONSE");
+    let first = alice.invite(ROOM, BOB).expect_err("first Commit ACK must be lost");
+    assert!(first.contains("500"), "expected injected response loss: {first}");
+    assert_eq!(alice.pending_membership_commits().unwrap(), 1);
+    assert_eq!(alice.pending_key_package_intents().unwrap(), 1);
+
+    alice.invite(ROOM, BOB).expect("retry after replayed ACK is an idempotent success");
+    assert_eq!(alice.pending_membership_commits().unwrap(), 0);
+    assert_eq!(alice.pending_key_package_intents().unwrap(), 0);
+    assert_eq!(alice.local_epoch(ROOM), Some(1));
+    bob.sync().unwrap();
+    assert!(bob.members_of(ROOM).unwrap().iter().any(|member| member == "@bob:inone.test/B_PHONE"));
+}
