# Production template. Replace every placeholder; do not commit a filled .env file.
NODE_ENV=production
PORT=8080
# Use a real PostgreSQL connection string. Keep credentials in the deployment secret store.
DATABASE_URL=postgresql://inone:REPLACE_WITH_DB_PASSWORD@DB_HOST:5432/inone
INONE_PIN_PEPPER=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
INONE_PUBLIC_URL=https://api.example.com
INONE_REGISTRATION_MODE=verified
INONE_REQUIRE_PHONE=false
# Set true only behind a trusted reverse proxy that overwrites forwarding headers.
INONE_TRUST_PROXY=true
INONE_BODY_LIMIT_BYTES=4194304
INONE_REQUEST_TIMEOUT_MS=30000
LOG_LEVEL=info
INONE_RUN_MIGRATIONS=true
INONE_FILES_DIR=/var/lib/inone/files
INONE_DOCS_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
INONE_TEST_UI=0
INONE_MAIL_TRANSPORT=smtp
INONE_SMTP_HOST=smtp.example.com
INONE_SMTP_PORT=587
INONE_SMTP_SECURE=false
INONE_SMTP_REQUIRE_TLS=true
INONE_SMTP_USER=REPLACE_WITH_SMTP_USER
INONE_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
INONE_SMTP_FROM=InOne <no-reply@example.com>
# Keep SMS disabled until a real provider is configured and tested.
INONE_SMS_ENABLED=false
