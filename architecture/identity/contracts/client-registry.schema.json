{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.inone.invalid/identity/client-registry.schema.json",
  "title": "InOne Identity logical client registry",
  "type": "object",
  "required": [
    "contractVersion",
    "status",
    "issuer",
    "protocol",
    "audiences",
    "clients",
    "serviceClients",
    "claims",
    "blockers"
  ],
  "properties": {
    "contractVersion": {
      "const": "0.1"
    },
    "status": {
      "const": "logical-registration-baseline-not-enabled"
    },
    "issuer": {
      "const": "IDENTITY_ISSUER_URL"
    },
    "protocol": {
      "type": "object",
      "required": [
        "responseTypes",
        "grantTypes",
        "pkce",
        "dynamicClientRegistration",
        "implicitGrant",
        "resourceOwnerPasswordGrant",
        "redirectUriPolicy",
        "audiencePolicy"
      ],
      "properties": {
        "responseTypes": {
          "const": [
            "code"
          ]
        },
        "grantTypes": {
          "const": [
            "authorization_code",
            "refresh_token"
          ]
        },
        "pkce": {
          "type": "object",
          "required": [
            "required",
            "methods",
            "plainAllowed"
          ],
          "properties": {
            "required": {
              "const": true
            },
            "methods": {
              "const": [
                "S256"
              ]
            },
            "plainAllowed": {
              "const": false
            }
          },
          "additionalProperties": false
        },
        "dynamicClientRegistration": {
          "const": false
        },
        "implicitGrant": {
          "const": false
        },
        "resourceOwnerPasswordGrant": {
          "const": false
        },
        "redirectUriPolicy": {
          "type": "string"
        },
        "audiencePolicy": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "audiences": {
      "type": "object",
      "required": [
        "inone",
        "inone_business",
        "propo"
      ],
      "properties": {
        "inone": {
          "const": "urn:inone:api"
        },
        "inone_business": {
          "const": "urn:inone-business:api"
        },
        "propo": {
          "const": "urn:propo:api"
        }
      },
      "additionalProperties": false
    },
    "clients": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "clientId",
          "product",
          "kind",
          "contexts",
          "audience",
          "authMethod",
          "pkce",
          "redirectUris",
          "status"
        ],
        "properties": {
          "clientId": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+$"
          },
          "product": {
            "enum": [
              "inone",
              "inone_business",
              "propo"
            ]
          },
          "kind": {
            "enum": [
              "public-native",
              "confidential-bff"
            ]
          },
          "contexts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "personal",
                "work"
              ]
            }
          },
          "audience": {
            "enum": [
              "urn:inone:api",
              "urn:inone-business:api",
              "urn:propo:api"
            ]
          },
          "authMethod": {
            "enum": [
              "none",
              "private_key_jwt"
            ]
          },
          "pkce": {
            "const": true
          },
          "redirectUris": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^[^*]+$"
            }
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "serviceClients": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "clientId",
          "purpose",
          "auth",
          "scopes"
        ],
        "properties": {
          "clientId": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "auth": {
            "type": "array",
            "contains": {
              "const": "mutual_tls"
            },
            "items": {
              "enum": [
                "private_key_jwt",
                "mutual_tls"
              ]
            }
          },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "object",
      "required": [
        "required",
        "optional",
        "forbidden",
        "productAccountReference"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "productAccountReference": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "blockers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
