          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProvisioningAck"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "UserAccessToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "RecoveryGrant": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "description": "Single-use, 10-minute, purpose/client/device-bound grant."
      },
      "ServiceAccessToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "ServiceMutualTLS": {
        "type": "mutualTLS"
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        }
      },
      "CorrelationId": {
        "name": "X-Correlation-ID",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "retryable",
              "request_id"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              },
              "request_id": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "RegistrationRequest": {
        "type": "object",
        "required": [
          "entry_product",
          "account_context",
          "phone",
          "email",
          "password",
          "client_id",
          "device",
          "terms_version"
        ],
        "properties": {
          "entry_product": {
            "const": "inone"
          },
          "account_context": {
            "const": "personal"
          },
          "phone": {
            "type": "string",
            "minLength": 7,
            "maxLength": 32
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 256,
            "writeOnly": true
          },
          "client_id": {
            "const": "inone-mobile"
          },
          "device": {
            "type": "object",
            "required": [
              "client_instance_id",
              "platform",
              "display_name"
            ],
            "properties": {
              "client_instance_id": {
                "type": "string",
                "minLength": 16
              },
              "platform": {
                "enum": [
                  "ios",
                  "android",
                  "web"
                ]
              },
              "display_name": {
                "type": "string",
                "maxLength": 80
              }
            },
            "additionalProperties": false
          },
          "terms_version": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RecoveryStart": {
        "type": "object",
        "required": [
          "identifier"
        ],
        "properties": {
          "identifier": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254,
            "writeOnly": true
          }
        },
        "additionalProperties": false
      },
      "RecoveryChallenge": {
        "type": "object",
        "required": [
          "attempt_id",
          "proof"
        ],
        "properties": {
          "attempt_id": {
            "type": "string",
            "format": "uuid"
          },
          "proof": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "passkey",
                  "recovery_code",
                  "trusted_device"
                ]
              },
              "assertion": {
                "type": "object"
              },
              "recovery_code": {
                "type": "string",
                "writeOnly": true
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "RecoveryComplete": {
        "type": "object",
        "required": [
          "new_password"
        ],
        "properties": {
          "new_password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 256,
            "writeOnly": true
          }
        },
        "additionalProperties": false
      },
      "ContactChange": {
        "type": "object",
        "required": [
          "new_value"
        ],
        "properties": {
          "new_value": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254,
            "writeOnly": true
          }
        },
        "additionalProperties": false
      },
      "ProvisioningOperation": {
        "type": "object",
        "required": [
          "request_id",
          "idempotency_key",
          "identity_id",
          "entry_product",
          "account_context",
          "invitation_reference",
          "requested_products",
          "provisioning_policy_version"
        ],
        "properties": {
          "request_id": {
            "type": "string"
          },
          "idempotency_key": {
            "type": "string"
          },
          "identity_id": {
            "type": "string",
            "format": "uuid"
          },
          "entry_product": {
            "const": "inone_business"
          },
          "account_context": {
            "const": "work"
          },
          "invitation_reference": {
            "type": "string"
          },
          "requested_products": {
            "const": [
              "inone_business",
              "propo"
            ]
          },
          "provisioning_policy_version": {
            "const": "1"
          }
        },
        "additionalProperties": false
      },
      "ProvisioningAck": {
        "type": "object",
        "required": [
          "operation_id",
          "step_id",
          "product",
          "product_account_id",
          "account_context",
          "status",
          "product_contract_version",
          "correlation_id"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "step_id": {
            "type": "string",
            "format": "uuid"
          },
          "product": {
            "enum": [
              "inone_business",
              "propo"
            ]
          },
          "product_account_id": {
            "type": "string"
          },
          "account_context": {
            "const": "work"
          },
          "status": {
            "enum": [
              "succeeded",
              "failed_retryable",
              "failed_permanent"
            ]
          },
          "product_contract_version": {
            "type": "string"
          },
          "correlation_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "GenericAccepted": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "operation_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": true
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request; no internal details or contact values disclosed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication or recovery grant invalid/expired.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Required scope or step-up assurance missing.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "Conflict without revealing another identity/contact claimant.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Rate limit exceeded.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unavailable": {
        "description": "Temporary dependency failure; no false provisioning success.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
