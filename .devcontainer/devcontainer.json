{
  "name": "InOne local test environment",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "runServices": ["db", "app"],
  "shutdownAction": "stopCompose",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "InOne test API",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "postCreateCommand": "cd inone-engine-poc-0.6.0 && npm ci",
  "postStartCommand": "bash .devcontainer/start-backend.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "remoteUser": "node"
}
