# Скопировать в .env и заполнить. Значения с change-me не пригодны для продакшена.
NODE_ENV=production
PORT=8080
POSTGRES_PASSWORD=change-me-set-in-your-environment
DATABASE_URL=postgresql://HOST:5432/DATABASE (логин и пароль задаются переменной окружения)
# 32 символа и больше, случайные. Не тестовые и не примеры.
INONE_PIN_PEPPER=change-me-set-in-your-environment
# Публичный адрес за HTTPS-прокси.
INONE_PUBLIC_URL=https://inone.example.com
INONE_REGISTRATION_MODE=verified
# true только если сервер стоит за доверенным прокси, который задаёт адрес клиента.
INONE_TRUST_PROXY=false
INONE_BODY_LIMIT_BYTES=4194304
INONE_REQUEST_TIMEOUT_MS=30000
LOG_LEVEL=info
INONE_RUN_MIGRATIONS=true
# Почтовая доставка: SMTP + PostgreSQL outbox. До выбора провайдера оставьте placeholders.
INONE_MAIL_TRANSPORT=smtp
INONE_SMTP_HOST=smtp.example.net
INONE_SMTP_PORT=587
INONE_SMTP_SECURE=false
INONE_SMTP_REQUIRE_TLS=true
INONE_SMTP_USER=mailer@example.com
INONE_SMTP_PASSWORD=replace-in-secret-manager
INONE_SMTP_FROM=InOne <noreply@example.com>
# Случайный независимый 32-байтовый ключ: 64 hex-символа. Хранить только в secret manager.
INONE_EMAIL_ENCRYPTION_KEY=replace-with-64-hex-characters
INONE_EMAIL_WORKER_POLL_MS=1000
INONE_EMAIL_MAX_ATTEMPTS=8
