# Скопировать в .env и заполнить. Значения с change-me не пригодны для продакшена.
NODE_ENV=production
PORT=8080
POSTGRES_PASSWORD=change-me-set-in-your-environment
# URI format only; inject real credentials through the deployment secret manager.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# 32 символа и больше, случайные. Не тестовые и не примеры.
INONE_PIN_PEPPER=change-me-set-in-your-environment
# Публичный адрес за HTTPS-прокси.
INONE_PUBLIC_URL=https://inone.example.com
INONE_REGISTRATION_MODE=verified
# true только если сервер стоит за доверенным прокси, который задаёт адрес клиента.
INONE_TRUST_PROXY=false
INONE_BODY_LIMIT_BYTES=4194304
INONE_REQUEST_TIMEOUT_MS=30000
LOG_LEVEL=info
INONE_RUN_MIGRATIONS=true
# Локальная разработка: письма остаются в тестовом in-memory mailbox.
INONE_MAIL_TRANSPORT=memory

# Production only: SMTP + PostgreSQL encrypted outbox.
# После выбора провайдера задайте эти параметры в secret manager / deployment environment.
# INONE_MAIL_TRANSPORT=smtp
# INONE_SMTP_HOST=smtp.example.net
# INONE_SMTP_PORT=587
# INONE_SMTP_SECURE=false
# INONE_SMTP_REQUIRE_TLS=true
# INONE_SMTP_USER=mailer@example.com
# INONE_SMTP_PASSWORD=provided-by-secret-manager
# INONE_SMTP_FROM=InOne <noreply@example.com>
# Сгенерировать независимо 32 случайных байта (64 hex characters); не использовать PIN_PEPPER.
# Generate a fresh key with: openssl rand -hex 32
# INONE_EMAIL_ENCRYPTION_KEY=<64-hex-characters-from-openssl>
# INONE_EMAIL_WORKER_POLL_MS=1000
# INONE_EMAIL_MAX_ATTEMPTS=8

# Production push: FCM targets Firebase Installation IDs for both Android and iOS.
# iOS delivery is routed by Firebase through APNs; upload the APNs .p8 key in Firebase Console.
# Prefer Application Default Credentials / workload identity. If unavailable, inject JSON from a secret manager.
# INONE_FIREBASE_PROJECT_ID=inone-messenger
# INONE_FIREBASE_SERVICE_ACCOUNT_JSON=<secret-manager-injected-json>
# Generate a separate 32-byte key: openssl rand -hex 32 (never reuse PIN/email keys).
# INONE_PUSH_ENCRYPTION_KEY=<64-hex-characters-from-openssl>
# INONE_PUSH_WORKER_POLL_MS=1000
# INONE_PUSH_MAX_ATTEMPTS=8
