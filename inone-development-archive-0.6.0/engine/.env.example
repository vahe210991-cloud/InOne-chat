# Шаблон production-конфигурации. Все change-me значения необходимо заменить секретами из secret manager.
NODE_ENV=production
HOST=0.0.0.0
PORT=8080

# PostgreSQL: URL должен быть одной корректной строкой без поясняющего текста.
DATABASE_URL=postgresql://inone:change-me@HOST:5432/inone

# Случайные секреты: не менее 32 символов каждый. Не использовать примерные значения.
INONE_PIN_PEPPER=replace-with-random-secret-at-least-32-characters
INONE_DOCS_SECRET=replace-with-another-random-secret-at-least-32-characters
INONE_OBJECT_SECRET=replace-with-a-third-random-secret-at-least-32-characters

# Публичный HTTPS-адрес и каталог постоянного файлового хранилища.
INONE_PUBLIC_URL=https://inone.example.com
INONE_FILES_DIR=/var/lib/inone/objects
INONE_FILE_QUOTA_BYTES=1073741824

INONE_REGISTRATION_MODE=verified
# Телефон не обязателен, пока реальный SMS-провайдер не подключён и не проверен.
INONE_REQUIRE_PHONE=false
INONE_SMS_ENABLED=false

# true только за доверенным HTTPS-прокси, который перезаписывает forwarded headers.
INONE_TRUST_PROXY=false
INONE_BODY_LIMIT_BYTES=4194304
INONE_REQUEST_TIMEOUT_MS=30000
LOG_LEVEL=info
INONE_RUN_MIGRATIONS=true

# Реальная отправка кодов подтверждения: SMTP с TLS обязателен для production.
INONE_MAIL_TRANSPORT=smtp
INONE_SMTP_HOST=smtp.example.com
INONE_SMTP_PORT=587
INONE_SMTP_SECURE=false
INONE_SMTP_REQUIRE_TLS=true
INONE_SMTP_USER=replace-with-smtp-user
INONE_SMTP_PASSWORD=replace-with-smtp-password
INONE_SMTP_FROM=InOne <noreply@example.com>

# Не задавать в production: фиксированный тестовый код запрещён.
# INONE_DEV_EMAIL_CODE=
